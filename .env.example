# Copy this file to .env when you need local environment overrides.
# Set your local MySQL connection before starting the API.

FRONTEND_ORIGIN=http://localhost:3000
# API URLs in the browser are always same-origin /api.
# Set API_PROXY_TARGET in Frontend/.env.local for local development.
API_PROXY_TARGET=http://127.0.0.1:5243

ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;User ID=root;Password=root_native;Database=dental_care;SslMode=None;AllowPublicKeyRetrieval=True;

Jwt__Issuer=Dental-Care
Jwt__Audience=Dental-Care.Frontend
Jwt__SigningKey=replace-with-a-long-random-production-secret
Jwt__ExpiresHours=8

Swagger__Enabled=true
